# The committed Android host is source, not build output: it is here so the module
# compiles against SDK 37 on every checkout instead of the template's 36 (see
# settings.gradle and ../build.gradle). Everything below is regenerated by
# `flutter pub get` / `flutter build aar` and must stay out of the tree.

# flutter_tools copies the Gradle wrapper in from $FLUTTER_ROOT/bin/cache/artifacts/
# (gradle_utils.dart, injectGradleWrapperIfNeeded) the first time it needs it.
gradlew
gradlew.bat
gradle/

# `flutter pub get` writes the SDK locations; they are machine-specific.
local.properties

build/
.gradle/
